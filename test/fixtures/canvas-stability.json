        "environmental": {
          "canvasHash": {
            "supported": true,
            "canvasStable": false
          }
        }
      },
      "expected": {
        "category": "fingerprint",
        "score": 0.35,
        "confidence": 0.4,
        "reason": "Canvas readback changed between identical renders",
        "details": {
