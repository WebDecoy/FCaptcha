        "environmental": {
          "canvasHash": {
            "supported": true
          }
        }
      },
      "expected": null
    },
    {
      "name": "malformed string is neutral",
      "signals": {
        "environmental": {
          "canvasHash": {
            "supported": true,
            "canvasStable": "false"
          }
        }
      },
      "expected": null
    },
    {
