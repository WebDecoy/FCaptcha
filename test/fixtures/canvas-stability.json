        }
      }
    },
    {
      "name": "stable repeated readback",
      "signals": {
        "environmental": {
          "canvasHash": {
            "supported": true,
            "canvasStable": true
          }
        }
      },
      "expected": null
    },
    {
      "name": "older client without stability field",
