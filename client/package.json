{
  "name": "@webdecoy/fcaptcha-client",
  "version": "1.24.0",
  "description": "Browser widget for FCaptcha \u2014 proof of work, behavioural signals, and AI-agent detection",
  "main": "fcaptcha.js",
  "browser": "fcaptcha.js",
  "unpkg": "dist/fcaptcha.min.js",
  "jsdelivr": "dist/fcaptcha.min.js",
  "exports": {
    ".": "./fcaptcha.js",
